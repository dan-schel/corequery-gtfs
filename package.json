{
  "name": "corequery-gtfs",
  "version": "0.16.5",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest --run",
    "test-performance": "tsx scripts/performance-test/main.ts",
    "test-coverage": "vitest --run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p scripts/performance-test/tsconfig.json --noEmit && eslint . --max-warnings 0 && knip",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "bump-check": "bump-check --ignore \"^renovate\\/\""
  },
  "dependencies": {
    "temporal-polyfill": "1.0.6"
  },
  "devDependencies": {
    "@dan-schel/js-utils": "4.14.1",
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.9",
    "@vitest/coverage-v8": "5.0.5",
    "csv-parser": "3.2.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "author": "dan-schel",
  "description": "Library for parsing services from GTFS feeds for CoreQuery.",
  "homepage": "https://github.com/dan-schel/corequery-gtfs",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "corequery",
    "gtfs",
    "trainquery"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:dan-schel/corequery-gtfs.git"
  },
  "bugs": {
    "url": "https://github.com/dan-schel/corequery-gtfs/issues"
  }
}
