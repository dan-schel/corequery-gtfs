{
  "name": "corequery-gtfs",
  "version": "0.3.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest --run",
    "test-coverage": "vitest --run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit && eslint . --max-warnings 0 && knip",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "bump-check": "bump-check --ignore \"^renovate\\/\""
  },
  "dependencies": {
    "temporal-polyfill": "1.0.1"
  },
  "devDependencies": {
    "@dan-schel/js-utils": "4.14.1",
    "@eslint/js": "10.0.1",
    "@types/node": "25.8.0",
    "@vitest/coverage-v8": "4.1.6",
    "csv-parser": "3.2.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "knip": "6.14.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.6",
    "zod": "4.4.3"
  },
  "author": "dan-schel",
  "description": "Library for parsing services from GTFS feeds for CoreQuery.",
  "homepage": "https://github.com/dan-schel/corequery-gtfs",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "corequery",
    "gtfs",
    "trainquery"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:dan-schel/corequery-gtfs.git"
  },
  "bugs": {
    "url": "https://github.com/dan-schel/corequery-gtfs/issues"
  }
}
