{
  // typescript-eslint wants all files it lints to be part of a TypeScript
  // project, because it uses type information to lint some of its rules. This
  // lint tsconfig is also used for type checking because it includes the test
  // folder.
  "include": ["**/*"],
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  }
}
